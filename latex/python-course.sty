\newcommand{\makefrontmatter}{%
  \section*{How to use this booklet}
  Each day is a working session, not a reading assignment. This booklet is the
  typeset version of the day's \texttt{README.md}: keep the folder open, type
  the examples into a Python REPL, and run the tests as you go. The
  \emph{Exam lens} and end-of-day review are study aids added to the
  original material.
  \par\vspace{0.9em}%
  \noindent
  \begin{minipage}[t]{0.232\linewidth}\RaggedRight
    \textcolor{accent}{\rule{\linewidth}{1.4pt}}\par\vspace{5pt}
    {\color{accent}\Large\faBookOpen}\par\vspace{2pt}
    {\sffamily\bfseries\small Read \& type}\par
    {\fontsize{8.2}{10.4}\selectfont\color{muted}Type every example. Predict the output first.}
  \end{minipage}\hfill
  \begin{minipage}[t]{0.232\linewidth}\RaggedRight
    \textcolor{accent}{\rule{\linewidth}{1.4pt}}\par\vspace{5pt}
    {\color{accent}\Large\faKeyboard}\par\vspace{2pt}
    {\sffamily\bfseries\small Practice}\par
    {\fontsize{8.2}{10.4}\selectfont\color{muted}Implement or debug one test at a time.}
  \end{minipage}\hfill
  \begin{minipage}[t]{0.232\linewidth}\RaggedRight
    \textcolor{accent}{\rule{\linewidth}{1.4pt}}\par\vspace{5pt}
    {\color{accent}\Large\faCheckCircle}\par\vspace{2pt}
    {\sffamily\bfseries\small Test}\par
    {\fontsize{8.2}{10.4}\selectfont\color{muted}Run the suite. Read the first failing line.}
  \end{minipage}\hfill
  \begin{minipage}[t]{0.232\linewidth}\RaggedRight
    \textcolor{accent}{\rule{\linewidth}{1.4pt}}\par\vspace{5pt}
    {\color{accent}\Large\faBug}\par\vspace{2pt}
    {\sffamily\bfseries\small Log}\par
    {\fontsize{8.2}{10.4}\selectfont\color{muted}Record each bug in \texttt{bug\_journal.md}.}
  \end{minipage}
  \par\vspace{1.1em}%
  {\sffamily\fontsize{9}{11}\selectfont\textbf{You will need:}\enspace
   Python 3.10+\enspace\textcolor{rule}{·}\enspace
   a terminal\enspace\textcolor{rule}{·}\enspace
   \texttt{\courseFolder/}\enspace\textcolor{rule}{·}\enspace
   the course runner \texttt{python run.py \courseDayInt}}\par
  \vspace{0.8em}%
  \tableofcontents
  \clearpage
}

\newcommand{\scoreline}{%
  \ifnum\courseTestCount>0\relax
    \par\vspace{5pt}\noindent
    {\sffamily\bfseries\small\color{primary}Score:}\enspace
