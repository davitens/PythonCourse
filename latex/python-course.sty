% ======================================================================
%  python-course.sty
%  Shared visual system for the 10-Day Python Debugging Course booklets.
%  Compile with XeLaTeX + shell escape (for minted/Pygments).
% ======================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{python-course}[2026/11/04 Python debugging course style]

% ---------- Typography -------------------------------------------------
\RequirePackage{fontspec}
\RequirePackage{unicode-math}

\setmainfont{SourceSerifPro}[
  Path=/usr/share/texmf-dist/fonts/opentype/adobe/sourceserifpro/,
  UprightFont=*-Regular.otf,
  ItalicFont=*-RegularIt.otf,
  BoldFont=*-Bold.otf,
  BoldItalicFont=*-BoldIt.otf,
  Ligatures=TeX
]
\setsansfont{Inter}[
  Path=/usr/share/texmf-dist/fonts/opentype/public/inter/,
  UprightFont=*-Regular.otf,
  ItalicFont=*-Italic.otf,
  BoldFont=*-SemiBold.otf,
  BoldItalicFont=*-SemiBoldItalic.otf,
  RawFeature={-case,-calt}
]
\setmonofont{SourceCodePro}[
  Path=/usr/share/texmf-dist/fonts/opentype/adobe/sourcecodepro/,
  UprightFont=*-Regular.otf,
