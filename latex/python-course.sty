% ---------- Section styling -------------------------------------------
\RequirePackage{titlesec}
\RequirePackage{titletoc}

\titleformat{\section}[block]
  {\sffamily\Large\bfseries\color{primary}}
  {\setlength{\fboxsep}{3.2pt}\colorbox{accent}{\textcolor{white}{\thesection}}}
  {0.72em}{}
  [\vspace{0.32em}{\color{rule}\titlerule[0.6pt]}]
\titlespacing*{\section}{0pt}{17pt plus 5pt minus 3pt}{8pt}

\titleformat{\subsection}[hang]
  {\sffamily\large\bfseries\color{primary}}
  {\textcolor{accent}{\rule[-0.16em]{2.6pt}{1.02em}}\hspace{0.5em}\thesubsection}
  {0.55em}{}
\titlespacing*{\subsection}{0pt}{12pt plus 3pt minus 2pt}{5pt}

\titleformat{\subsubsection}[runin]
  {\sffamily\bfseries\color{primary}}{}{0pt}{}
  [\enspace]
\titlespacing*{\subsubsection}{0pt}{8pt plus 2pt}{0.4em}

% Numberless section headings (front matter, catalog letters, Parts)
\titleformat{name=\section,numberless}[block]
  {\sffamily\Large\bfseries\color{primary}}{}{0pt}{}
  [\vspace{0.32em}{\color{rule}\titlerule[0.6pt]}]
\titleformat{name=\subsection,numberless}[hang]
  {\sffamily\large\bfseries\color{primary}}{}{0pt}{}
\titlespacing*{\subsection}{0pt}{12pt plus 3pt minus 2pt}{5pt}

\newcommand{\unnumberedsection}[1]{%
  \section*{#1}%
  \addcontentsline{toc}{section}{#1}%
}
\newcommand{\unnumberedsubsection}[1]{\subsection*{#1}}

\renewcommand{\contentsname}{In this session}
\titlecontents{section}[0pt]
  {\addvspace{4.5pt}\sffamily\bfseries\color{primary}}
  {\contentslabel{2.35em}}
  {\hspace*{-2.35em}}
  {\hfill\color{muted}\contentspage}
\setcounter{tocdepth}{1}

% ---------- Lists ------------------------------------------------------
\RequirePackage{enumitem}
\setlist[itemize]{leftmargin=1.35em,itemsep=2.5pt,topsep=3pt,parsep=0pt,
  label={\textcolor{accent}{\raisebox{0.12em}{\scriptsize\textbullet}}}}
\setlist[enumerate]{leftmargin=1.9em,itemsep=4pt,topsep=4pt,parsep=1pt,
  label={\textcolor{accent}{\sffamily\bfseries\arabic*.}}}
\setlist[itemize,2]{leftmargin=1.15em,itemsep=1.5pt,
  label={\textcolor{accent}{\scriptsize--}}}
\setlist[enumerate,2]{leftmargin=1.35em,itemsep=2pt,
  label={\textcolor{accent}{\sffamily\bfseries\alph*.}}}
\newlist{checklist}{itemize}{1}
\setlist[checklist]{leftmargin=1.55em,itemsep=3.5pt,topsep=2pt,parsep=1pt,
  label={\textcolor{teal}{\faSquare[regular]}}}

% ---------- Tables -----------------------------------------------------
\RequirePackage{booktabs}
\RequirePackage{xltabular}
\RequirePackage{ragged2e}
\RequirePackage{needspace}
\newcolumntype{Y}[1]{>{\hsize=#1\hsize\RaggedRight\arraybackslash}X}
\newcommand{\thd}[1]{\textcolor{white}{\sffamily\bfseries #1}}

\newcommand{\code}[1]{{\ttfamily\hyphenchar\font=-1\relax #1}}

\newenvironment{datatable}[2]{%
  \par\vspace{4pt}\begingroup
  \renewcommand{\arraystretch}{1.32}%
  \setlength{\tabcolsep}{4.5pt}%
  \hyphenpenalty=10000
  \exhyphenpenalty=10000
  #2%
  \rowcolors{2}{white}{tablealt}%
  \arrayrulecolor{rule}%
}{%
  \par\endgroup\vspace{5pt}%
}

% ---------- Code -------------------------------------------------------
\RequirePackage{minted}
\newminted[pycode]{python}{fontsize=\fontsize{8.7}{11.2}\selectfont,
  breaklines=true,breakanywhere=true,breakindent=2em,breaksymbolleft={},breaksymbolright={},tabsize=4,autogobble,
  bgcolor=codebg,frame=leftline,framerule=3pt,framesep=6pt,
  rulecolor=\color{accent}}
\newminted[shcode]{bash}{fontsize=\fontsize{8.7}{11.2}\selectfont,
  breaklines=true,breakanywhere=true,breakindent=2em,breaksymbolleft={},breaksymbolright={},tabsize=4,autogobble,
  bgcolor=codebg,frame=leftline,framerule=3pt,framesep=6pt,
  rulecolor=\color{teal}}
\newminted[replcode]{pycon}{fontsize=\fontsize{8.7}{11.2}\selectfont,
  breaklines=true,breakanywhere=true,breakindent=2em,breaksymbolleft={},breaksymbolright={},tabsize=4,autogobble,
  bgcolor=codebg,frame=leftline,framerule=3pt,framesep=6pt,
  rulecolor=\color{teal}}
\newminted[txtcode]{text}{fontsize=\fontsize{8.7}{11.2}\selectfont,
  breaklines=true,breakanywhere=true,breakindent=2em,breaksymbolleft={},breaksymbolright={},tabsize=4,autogobble,
  bgcolor=codebg,frame=leftline,framerule=3pt,framesep=6pt,
  rulecolor=\color{muted}}
% A fallback for the one code block that contains U+FFFD, which Source Code
% Pro does not cover. DejaVu Sans Mono does.
\newfontfamily\dejavumono{DejaVu Sans Mono}
\newminted[utfcode]{python}{fontsize=\fontsize{8.7}{11.2}\selectfont,
  breaklines=true,breakanywhere=true,breakindent=2em,breaksymbolleft={},breaksymbolright={},tabsize=4,autogobble,
  formatcom=\dejavumono,
  bgcolor=codebg,frame=leftline,framerule=3pt,framesep=6pt,
  rulecolor=\color{accent}}

