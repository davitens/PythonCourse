}

\newcommand{\bugjournal}{%
  \Needspace{9\baselineskip}%
  \par\vspace{13pt}%
  \noindent{\sffamily\bfseries\color{primary}\faBug\enspace Tonight's bug journal}\par
  \vspace{3pt}%
  \begingroup
  \renewcommand{\arraystretch}{1.5}%
  \setlength{\tabcolsep}{5pt}%
  \arrayrulecolor{rule}%
  \begin{tabularx}{\linewidth}{@{}>{\RaggedRight\arraybackslash}X
                              >{\RaggedRight\arraybackslash}X
                              >{\RaggedRight\arraybackslash}X@{}}
    \rowcolor{primarylt}
    {\sffamily\bfseries\footnotesize Where} &
    {\sffamily\bfseries\footnotesize Symptom} &
    {\sffamily\bfseries\footnotesize Root cause / fix} \\
    \hline
    \rule{0pt}{1.35em} & & \\ \hline
    \rule{0pt}{1.35em} & & \\ \hline
    \rule{0pt}{1.35em} & & \\
  \end{tabularx}
  \endgroup
  \par\vspace{3pt}%
  {\sffamily\fontsize{7.6}{9}\selectfont\color{muted}One row per bug. Re-read this page on Day 10.}\par
}

