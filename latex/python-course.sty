\newcommand{\progressbar}{%
  \begingroup
  \setlength{\fboxsep}{0pt}%
  \count255=1
  \loop
    \ifnum\count255>\courseDayInt\relax
      \colorbox{rule}{\rule{0.68cm}{0.14cm}}%
    \else
      \colorbox{accent}{\rule{0.68cm}{0.14cm}}%
    \fi
    \ifnum\count255<10\relax\hspace{0.18em}\fi
    \advance\count255 by 1
  \ifnum\count255<11 \repeat
  \endgroup
}

